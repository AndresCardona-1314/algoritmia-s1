Algoritmo EdadEnDias
	Escribir 'Ingrese su edad: '
	Leer edad
	dias <- edad*365
	meses <- edad*12
	semanas <- edad*52
	horas <- edad*8760
	minutos <- edad*525600
	seg <- edad*31536000
	Escribir 'Su edad en días es: ', dias
	Escribir 'Su edad en meses es: ', meses
	Escribir 'Su edad en semanas es: ', semanas
	Escribir 'Su edad en horas es: ', horas
	Escribir 'Su edad en minutos es: ', minutos
	Escribir 'Su edad en segundos es: ', seg
FinAlgoritmo
