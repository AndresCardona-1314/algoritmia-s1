Algoritmo bisiesto
	
	Definir ano Como Entero
	
	Escribir "Ingresa el año para saber si es bisiesto: "
	Leer ano
	
	Si (ano%4=0 y ano%100<>0) o ano%400=0 Entonces
		Escribir "El año ingresado es bisiesto: ", ano
		
	SiNo
		Escribir "El año ingresado no es bisiesto: ", ano
		
	FinSi
	
	
	
	
	
FinAlgoritmo
